# Bu dosyayi ".env" adiyla kopyalayip degerleri orada doldurun.
# Gercek degerleri bu dosyaya yazmayin.

# Program ortami. Yalnizca tam olarak CANLI yazilirsa canli ortam acilir;
# bos, eksik veya baska bir deger her zaman TEST demektir.
ECZANE_ORTAM=

# PostgreSQL sunucusu (ana makinenin adresi ve portu)
ECZANE_DB_SUNUCU=
ECZANE_DB_PORT=

# Programin gunluk isler icin kullandigi hesap. Tum bilgisayarlarda gerekir.
ECZANE_DB_KULLANICI=
ECZANE_DB_PAROLA=

# Tablo yapisini guncelleyen hesap. YALNIZCA ana makinede doldurulur.
ECZANE_DB_SAHIP_KULLANICI=
ECZANE_DB_SAHIP_PAROLA=
